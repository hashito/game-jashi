    {
      "id": "verify-voice-crank",
      "kind": "process",
      "pool": "cpu",
      "purpose": "完成済み音声の検証（再合成しない）: crank",
      "inputs": [
        "dist/assets/audio/guide-crank.wav",
        "tools/local-media-records/voice-crank.json",
        "tools/local-media-voices.json",
        "tools/local-media-worker.py"
      ],
      "outputs": [
        "tools/local-media-verification/voice-crank.json"
