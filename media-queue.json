{
  "version": 1,
  "concurrency": 3,
  "pools": {
    "gpu": 1,
    "voice-cpu": 1,
    "cpu": 2
  },
  "jobs": [
    {
      "id": "verify-voice-telescope",
      "kind": "process",
      "pool": "cpu",
      "purpose": "完成済み音声の検証（再合成しない）: telescope",
      "inputs": [
        "dist/assets/audio/guide-telescope.wav",
        "tools/local-media-records/voice-telescope.json",
        "tools/local-media-voices.json",
        "tools/local-media-worker.py"
      ],
      "outputs": [
        "tools/local-media-verification/voice-telescope.json"
      ],
      "command": [
        "D:/AI/ComfyUI/venv/Scripts/python.exe",
        "tools/local-media-worker.py",
        "verify-voice",
        "telescope"
      ],
      "retries": 0,
      "timeoutMs": 60000
    },
    {
      "id": "verify-voice-radio",
      "kind": "process",
      "pool": "cpu",
      "purpose": "完成済み音声の検証（再合成しない）: radio",
