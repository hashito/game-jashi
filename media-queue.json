        "tools/local-media-worker.py"
      ],
      "outputs": [
        "tools/local-media-verification/voice-note.json"
      ],
      "command": [
        "D:/AI/ComfyUI/venv/Scripts/python.exe",
        "tools/local-media-worker.py",
        "verify-voice",
        "note"
      ],
      "retries": 0,
      "timeoutMs": 60000
    },
    {
      "id": "verify-voice-bottle",
      "kind": "process",
      "pool": "cpu",
      "purpose": "完成済み音声の検証（再合成しない）: bottle",
