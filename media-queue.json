        "tools/local-media-worker.py",
        "verify-voice",
        "car"
      ],
      "retries": 0,
      "timeoutMs": 60000
    },
    {
      "id": "photo-arrival",
      "kind": "image",
      "pool": "cpu",
      "purpose": "導入。片付けのために来た、昼の別荘の記録。",
      "inputs": [
        "tools/photo-prompts.json",
        "tools/prepare-photo.py",
        "tools/local-media-worker.py",
        "assets/sources/arrival.png"
      ],
      "outputs": [
        "dist/assets/photos/arrival-v4-1.webp",
        "tools/local-media-records/image-arrival.json"
      ],
      "command": [
        "D:/AI/ComfyUI/venv/Scripts/python.exe",
        "tools/prepare-photo.py",
        "arrival"
      ],
      "retries": 0,
      "timeoutMs": 60000
    },
    {
      "id": "photo-return",
      "kind": "image",
      "pool": "cpu",
      "purpose": "生還後。山を下りたことを写真で伝える。",
      "inputs": [
        "tools/photo-prompts.json",
        "tools/prepare-photo.py",
        "tools/local-media-worker.py",
        "assets/sources/return.png"
      ],
      "outputs": [
        "dist/assets/photos/return-v4-1.webp",
        "tools/local-media-records/image-return.json"
      ],
      "command": [
        "D:/AI/ComfyUI/venv/Scripts/python.exe",
        "tools/prepare-photo.py",
        "return"
      ],
      "retries": 0,
      "timeoutMs": 60000
    },
    {
      "id": "photo-evidence",
      "kind": "image",
      "pool": "cpu",
      "purpose": "古写真。手前の森と奥の白い頭を読み分けられる資料。",
      "inputs": [
        "tools/photo-prompts.json",
        "tools/prepare-photo.py",
        "tools/local-media-worker.py",
        "assets/sources/evidence.png"
      ],
      "outputs": [
        "dist/assets/photos/mountain-v4-1.webp",
        "tools/local-media-records/image-evidence.json"
      ],
      "command": [
        "D:/AI/ComfyUI/venv/Scripts/python.exe",
        "tools/prepare-photo.py",
        "evidence"
      ],
      "retries": 0,
      "timeoutMs": 60000
    },
    {
      "id": "verified-ledger",
      "kind": "process",
      "pool": "cpu",
      "inputs": [
        "dist/assets/audio/guide-telescope.wav",
        "tools/local-media-records/voice-telescope.json",
        "dist/assets/audio/guide-radio.wav",
        "tools/local-media-records/voice-radio.json",
        "dist/assets/audio/guide-glasses.wav",
        "tools/local-media-records/voice-glasses.json",
        "dist/assets/audio/guide-note.wav",
        "tools/local-media-records/voice-note.json",
        "dist/assets/audio/guide-bottle.wav",
        "tools/local-media-records/voice-bottle.json",
        "dist/assets/audio/guide-crank.wav",
        "tools/local-media-records/voice-crank.json",
        "dist/assets/audio/guide-gate.wav",
        "tools/local-media-records/voice-gate.json",
        "dist/assets/audio/guide-car.wav",
        "tools/local-media-records/voice-car.json",
        "dist/assets/photos/arrival-v4-1.webp",
        "tools/local-media-records/image-arrival.json",
        "dist/assets/photos/return-v4-1.webp",
        "tools/local-media-records/image-return.json",
        "dist/assets/photos/mountain-v4-1.webp",
        "tools/local-media-records/image-evidence.json",
        "tools/local-media-worker.py",
        "tools/local-media-verification/voice-telescope.json",
        "tools/local-media-verification/voice-radio.json",
        "tools/local-media-verification/voice-glasses.json",
        "tools/local-media-verification/voice-note.json",
        "tools/local-media-verification/voice-bottle.json",
        "tools/local-media-verification/voice-crank.json",
        "tools/local-media-verification/voice-gate.json",
        "tools/local-media-verification/voice-car.json",
        "tools/local-media-records/boots-detail-v4-2.json",
        "dist/assets/photos/boots-detail-v4-2.webp",
        "tools/local-media-verification/boots-detail-v4-2.json",
        "tools/local-media-records/ledger-detail-v4-2.json",
        "dist/assets/photos/ledger-detail-v4-2.webp",
        "tools/local-media-verification/ledger-detail-v4-2.json",
        "tools/local-media-records/mirror-detail-v4-2.json",
        "dist/assets/photos/mirror-detail-v4-2.webp",
        "tools/local-media-verification/mirror-detail-v4-2.json",
        "tools/photo-briefs-v4.2.json"
      ],
      "outputs": [
        "assets/production.json"
      ],
      "command": [
        "D:/AI/ComfyUI/venv/Scripts/python.exe",
        "tools/local-media-worker.py",
        "ledger"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "verify-boots-detail-v4-2",
      "kind": "process",
      "pool": "cpu",
      "purpose": "生成済み接写のハッシュ・形式・容量検査: boots-detail",
      "inputs": [
        "dist/assets/photos/boots-detail-v4-2.webp",
        "tools/local-media-records/boots-detail-v4-2.json",
        "tools/photo-briefs-v4.2.json",
        "tools/verify-evidence.mjs"
      ],
      "outputs": [
        "tools/local-media-verification/boots-detail-v4-2.json"
      ],
      "command": [
        "node",
        "tools/verify-evidence.mjs",
        "boots-detail"
      ],
      "retries": 0,
      "timeoutMs": 60000
    },
    {
      "id": "verify-ledger-detail-v4-2",
      "kind": "process",
      "pool": "cpu",
      "purpose": "生成済み接写のハッシュ・形式・容量検査: ledger-detail",
      "inputs": [
        "dist/assets/photos/ledger-detail-v4-2.webp",
        "tools/local-media-records/ledger-detail-v4-2.json",
        "tools/photo-briefs-v4.2.json",
        "tools/verify-evidence.mjs"
      ],
      "outputs": [
        "tools/local-media-verification/ledger-detail-v4-2.json"
      ],
      "command": [
        "node",
        "tools/verify-evidence.mjs",
        "ledger-detail"
      ],
      "retries": 0,
      "timeoutMs": 60000
    },
    {
      "id": "verify-mirror-detail-v4-2",
      "kind": "process",
      "pool": "cpu",
      "purpose": "生成済み接写のハッシュ・形式・容量検査: mirror-detail",
      "inputs": [
        "dist/assets/photos/mirror-detail-v4-2.webp",
