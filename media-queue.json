      "inputs": [
        "dist/assets/audio/guide-gate.wav",
        "tools/local-media-records/voice-gate.json",
        "tools/local-media-voices.json",
        "tools/local-media-worker.py"
      ],
      "outputs": [
        "tools/local-media-verification/voice-gate.json"
      ],
      "command": [
        "D:/AI/ComfyUI/venv/Scripts/python.exe",
        "tools/local-media-worker.py",
        "verify-voice",
        "gate"
      ],
      "retries": 0,
      "timeoutMs": 60000
    },
    {
      "id": "verify-voice-car",
      "kind": "process",
      "pool": "cpu",
      "purpose": "完成済み音声の検証（再合成しない）: car",
      "inputs": [
        "dist/assets/audio/guide-car.wav",
        "tools/local-media-records/voice-car.json",
        "tools/local-media-voices.json",
        "tools/local-media-worker.py"
      ],
      "outputs": [
        "tools/local-media-verification/voice-car.json"
