        "tools/local-media-worker.py"
      ],
      "outputs": [
        "tools/local-media-verification/voice-radio.json"
      ],
      "command": [
        "D:/AI/ComfyUI/venv/Scripts/python.exe",
        "tools/local-media-worker.py",
        "verify-voice",
        "radio"
      ],
      "retries": 0,
      "timeoutMs": 60000
    },
