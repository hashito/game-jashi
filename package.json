{
  "name": "jashi-mountain",
  "version": "5.7.5",
  "private": true,
  "description": "投稿怪談『邪視』をもとにした一人称ホラー探索ゲーム（game-kit 3D 標準 1.9 版）",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node tools/check-game-data.mjs . && node tools/check-plan.mjs data/plan.json --strict",
    "plan": "node tools/check-plan.mjs data/plan.json --strict",
    "media": "node tools/check-game-data.mjs . --media",
    "serve": "node tools/serve.js",
    "smoke": "node tools/smoke.mjs",
    "smoke:mobile": "node tools/smoke.mjs --mobile",
    "stage": "node tools/check-stage.mjs . --tools",
    "stage:report": "node tools/check-stage.mjs . --tools --report",
    "selftest": "node tools/selftest-game.mjs",
    "check:emoji": "node tools/check-no-emoji.mjs js css data game.json index.html --skip-story",
    "check:pairs": "node tools/check-css-pairs.mjs css/theme-game.css",
    "check:wording": "node tools/check-wording.mjs js data --skip-story",
    "check:contrast": "node tools/check-text-contrast.mjs index.html --hooks tools/contrast-hooks/std.mjs --viewport 390x844,1920x1080 --shots shots/contrast",
    "sync-kit": "node ../game-kit/tools/kit-sync.js .",
    "og": "node tools/make-og.mjs",
    "build": "node tools/build-site.js",
    "check:traps": "node tools/check-traps.mjs .",
    "check:escape": "node tools/check-escape.mjs .",
    "check:copy": "node tools/check-copy.mjs . --strict"
  }
}
