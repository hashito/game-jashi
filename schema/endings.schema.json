{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "endings.json - how the game can end; the first ending (file order) whose requires all hold is shown",
  "type": "array", "minItems": 1, "uniqueBy": "id",
  "items": { "type": "object", "required": ["id", "title", "text"], "properties": {
    "id": { "type": "string" }, "title": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["good", "normal", "bad", "true"] }, "photo": { "type": "string" },
    "requires": { "type": "object", "properties": {
      "tasks": { "type": "array", "items": { "type": "string" } }, "items": { "type": "array", "items": { "type": "string" } }, "flags": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false }
  } }
}
