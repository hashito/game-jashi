{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release-notes.json - same content as js/release-notes.js NOTES (newest first). Deeper checks: validateNotes()",
  "type": "object", "required": ["version", "notes"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+(\\.\\d+){0,2}$" },
    "notes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["version", "date", "items"], "properties": {
      "version": { "type": "string", "pattern": "^\\d+(\\.\\d+){0,2}$" }, "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "title": { "type": "string" },
      "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type", "text"], "properties": { "type": { "enum": ["new", "fix", "change", "balance"] }, "text": { "type": "string", "minLength": 1 } } } } } } }
  }
}
